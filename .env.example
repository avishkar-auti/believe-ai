# Root-level environment variables shared across services when running via docker-compose.
# Copy this file to .env and fill in real values locally. Never commit .env.

# ---- API server ----
PORT=4000
MONGODB_URI=mongodb://localhost:27017/believe-ai
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173

# ---- Firebase Admin (server-side) ----
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY=your_firebase_private_key

# ---- Third-party AI providers (planned, later phases) ----
GEMINI_API_KEY=your_gemini_api_key_here
GROK_API_KEY=your_grok_api_key_here

NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000

MONGODB_URI=mongodb://localhost:27017/believe-ai
REDIS_URL=redis://localhost:6379

# Firebase service account (Project settings > Service accounts > Generate new private key).
# Keep the private key on one line with literal \n escapes, wrapped in double quotes.
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 32-byte hex key for AES-256-GCM encryption of stored OAuth refresh tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Gmail OAuth 2.0 credentials (Google Cloud Console > Credentials > Web application).
EMAIL_PROVIDER=gmail
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:4000/api/v1/integrations/gmail/callback

# Outlook OAuth credentials (Microsoft Entra > App registrations).
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:4000/api/v1/integrations/outlook/callback

EMAIL_DAILY_LIMIT_DEFAULT=200
EMAIL_SEND_CONCURRENCY=3

# The Python AI service (apps/ai-service) — used to compute resume embedding
# vectors, which this service then writes into Mongo itself (apps/ai-service
# stays read-only). The caller's own Firebase bearer token is forwarded as-is.
AI_SERVICE_URL=http://localhost:8000

# Judge0 CE via RapidAPI (https://rapidapi.com/judge0-official/api/judge0-ce) —
# powers the Interview Prep code sandbox. Optional: leave unset and the
# sandbox endpoint returns a clear "not configured" error instead of crashing.
RAPIDAPI_KEY=

# JSearch via RapidAPI (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch) —
# powers external listings on the Job Board. Optional: leave unset and the
# board shows internal (recruiter-posted) jobs only.
RAPIDAPI_JSEARCH_KEY=

# LinkedIn Data API via RapidAPI (https://rapidapi.com/rockapis-rockapis-default/api/linkedin-data-api) —
# powers Job Outreach's lead discovery (finding hiring-team/employee contacts
# at a target company). Optional: leave unset and lead discovery returns no
# contacts instead of erroring.
RAPIDAPI_LINKEDIN_KEY=

# YouTube Data API v3 (https://console.cloud.google.com/apis/library/youtube.googleapis.com) —
# powers real video resources on Learning Roadmap stages. Optional: leave unset
# and roadmap stages show documentation only, video sections report unavailable.
YOUTUBE_API_KEY=

# TURN relay for the Live Practice Room — optional. A public STUN server is
# always used as a baseline; without TURN, calls degrade to STUN-only (fine
# on most networks, but won't traverse strict NATs/firewalls).
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

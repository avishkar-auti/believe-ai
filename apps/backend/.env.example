# believe.ai backend (Python/FastAPI) — the sole backend, serving every
# route plus the arq background worker (worker/).
PORT=8000
CORS_ORIGIN=http://localhost:5173

# Firebase project — used to verify the web app's ID tokens.
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY=your_firebase_private_key

MONGODB_URI=mongodb://localhost:27017/believe-ai

# Backs the arq worker (worker/) — same Redis instance the API and worker
# both connect to (two processes, one datastore, no message broker between them).
REDIS_URL=redis://localhost:6379

# 32-byte hex key for AES-256-GCM encryption of OAuth refresh tokens at rest
# (core/crypto.py). Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=

# Comma-separated provider fallback order, e.g. "gemini,groq"
AI_PROVIDER_ORDER=gemini,groq
AI_REQUEST_TIMEOUT_SECONDS=20

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# Optional — only needed if you want Ollama itself to serve embeddings (e.g. "nomic-embed-text").
OLLAMA_EMBEDDING_MODEL=

# News feed's article source (clients/news_source_client.py). "mock" (default,
# no key needed) returns a curated dev/tech article pool — the real
# embedding-based retrieval/rerank still runs end to end against it.
NEWS_PROVIDER=mock
NEWS_API_KEY=

# Optional LangGraph/LangSmith tracing (core/tracing.py) for every agent
# graph (agents/news_search/, future ones). Leave unset — no traces are
# sent anywhere until this is configured. Get a key at smith.langchain.com.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=believe-ai

# Where OAuth consent redirects land the browser after connect/disconnect.
APP_BASE_URL=http://localhost:5173

# Gmail OAuth (services/integration_service.py). Leave unset to disable —
# connect attempts fail with a clear "not configured" error rather than
# crashing. Redirect URI must exactly match what's registered in Google Cloud Console.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/integrations/gmail/callback

# Outlook OAuth (services/integration_service.py), same "unset disables"
# behavior. Redirect URI must exactly match what's registered in Azure AD.
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:8000/integrations/outlook/callback

# Job Board's external search (clients/jsearch_client.py). Unset skips
# external results — internal listings still work fine.
RAPIDAPI_JSEARCH_KEY=

# Code sandbox's Judge0 key (services/code_sandbox_service.py). Unset raises
# a clear "not configured" error when a caller tries to run code.
RAPIDAPI_KEY=

# Roadmap's video enrichment (clients/youtube_client.py). Unset skips video
# search — the rest of a roadmap (stages, documentation) still generates fine.
YOUTUBE_API_KEY=

# TURN relay for the Live Practice Room's WebRTC signaling — optional.
# Without it, calls fall back to a public STUN server, which fails on
# networks that block direct peer-to-peer connections.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

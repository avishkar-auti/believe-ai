# believe.ai AI service (Python/FastAPI) — standalone, alongside the Node API.
PORT=8000
CORS_ORIGIN=http://localhost:5173

# Firebase project — same project as apps/api, used to verify the same ID tokens.
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY=your_firebase_private_key

MONGODB_URI=mongodb://localhost:27017/believe-ai

# Shared secret for apps/worker's backend-to-backend AI calls (it has no
# live user session). Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Must match apps/worker/.env's INTERNAL_SERVICE_KEY exactly.
INTERNAL_SERVICE_KEY=

# Comma-separated provider fallback order, e.g. "gemini,groq"
AI_PROVIDER_ORDER=gemini
AI_REQUEST_TIMEOUT_SECONDS=20

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# Optional — only needed if you want Ollama itself to serve embeddings (e.g. "nomic-embed-text").
OLLAMA_EMBEDDING_MODEL=

NODE_ENV=development

MONGODB_URI=mongodb://localhost:27017/believe-ai
REDIS_URL=redis://localhost:6379

# Must match apps/api's ENCRYPTION_KEY — the worker decrypts the OAuth
# refresh tokens the API encrypted.
ENCRYPTION_KEY=

# Leave EMAIL_PROVIDER unset to pick the provider per user from whichever
# integration they connected (Gmail or Outlook). Set it to "smtp" only to
# force SMTP for local testing without a real OAuth app.
# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:4000/api/v1/integrations/gmail/callback

OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=http://localhost:4000/api/v1/integrations/outlook/callback

EMAIL_SEND_CONCURRENCY=3
API_BASE_URL=http://localhost:4000
# Used to build the Live Practice Room join link in meeting invite/reminder emails.
APP_BASE_URL=http://localhost:5173

# The Python AI service — the only AI implementation in the product.
AI_SERVICE_URL=http://localhost:8000
# Shared secret for backend-to-backend AI calls (the worker has no user
# session). Must match apps/ai-service's INTERNAL_SERVICE_KEY exactly.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_SERVICE_KEY=

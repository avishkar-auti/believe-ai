node_modules/
dist/
build/
.turbo/
coverage/

# env files (examples ARE tracked). *.env (not just the exact name ".env")
# so a differently-named credentials dump — e.g. "atlas-credentials.env"
# saved from a MongoDB Atlas connection dialog — is covered too, anywhere
# in the tree, not just the exact filenames listed below.
*.env
.env.local
.env.*.local
!.env.example
!apps/*/.env.example

# service-account / admin key files a console download can drop anywhere in
# the tree (e.g. Firebase's "believe-8af92-firebase-adminsdk-*.json") — these
# are full admin credentials, never partial like a .env value.
*firebase-adminsdk*.json
*-service-account.json
*serviceAccountKey.json

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# editors / os
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# vite
apps/web/dist/
apps/web/.vite/

# misc
*.tsbuildinfo

# python (apps/backend)
.venv/
__pycache__/
*.pyc
.mypy_cache/
.ruff_cache/
apps/backend/data/
